# Konsyra Phase 0 Solana Validation Spike Environment Configuration
# DO NOT COMMIT PRIVATE KEYS OR CREDENTIALS TO VERSION CONTROL

# Source A and Source B must be independent endpoints for the live reconciliation gate.
# Never commit credentials. Public Solana RPC can support exploratory single-source
# testing, but does not satisfy the independent-source Phase 0 acceptance criterion.
KONSYRA_SOURCE_A_RPC_URL=
KONSYRA_SOURCE_B_RPC_URL=

# Solana Devnet RPC for Proof Digest Anchoring
KONSYRA_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Optional: Dedicated Solana Devnet Fee-Payer Private Key (Base58 or JSON byte array)
# USE EXCLUSIVELY A DEVNET TEST WALLET WITH ZERO MAINNET FUNDS
KONSYRA_DEVNET_PRIVATE_KEY=
